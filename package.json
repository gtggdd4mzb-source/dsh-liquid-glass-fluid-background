{
  "name": "dsh-liquid-glass-fluid-background",
  "version": "0.4.0",
  "description": "Liquid-glass surfaces and an independently configurable animated gradient background for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "Ink-bai5844",
  "contributors": ["gtggdd4mzb-source"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtggdd4mzb-source/dsh-liquid-glass-fluid-background.git"
  },
  "homepage": "https://github.com/gtggdd4mzb-source/dsh-liquid-glass-fluid-background#readme",
  "bugs": "https://github.com/gtggdd4mzb-source/dsh-liquid-glass-fluid-background/issues",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": ["lib", "locale", "assets/icon.svg", "cordis.patch.yml", "LICENSE", "THIRD_PARTY_NOTICES.md", "README.md", "README.zh.md", "CHANGELOG.md", "COMPATIBILITY.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:startup": "node test/startup.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run check"
  },
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.5 <0.2.3-0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "theme", "liquid-glass", "fluid"],
  "devDependencies": { "playwright": "^1.58.0" }
}
